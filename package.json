{
  "name": "svatah",
  "version": "0.1.0",
  "private": true,
  "description": "Svatah \u2014 a deterministic automation runtime with a standard agent surface",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm -r build",
    "browsers": "pnpm --filter @svatah/adapter-playwright exec playwright install chromium firefox",
    "fixtures": "node scripts/compile-fixtures.mjs",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "seed:bindings": "node scripts/seed-fixture-bindings.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "sample-web": "pnpm --filter sample-web start",
    "svatah": "node packages/cli/dist/bin.js",
    "conform:playwright": "node scripts/conform.mjs",
    "quick-start": "node scripts/quick-start.mjs",
    "eval:healing": "node scripts/eval-healing.mjs --report reports/eval-healing.md",
    "record:snapshots": "node scripts/record-snapshots.mjs",
    "grounding:cases": "node scripts/grounding-cases.mjs",
    "eval:grounding": "node scripts/eval-grounding.mjs --report reports/eval-grounding.md",
    "ade:client": "node scripts/generate-ade-client.mjs",
    "bidi:independence": "node scripts/bidi-independence.mjs --report reports/adapter-bidi.md",
    "eval:compiler": "node scripts/eval-compiler.mjs --report reports/eval-compiler.md",
    "eval:conformance": "node scripts/adapter-conformance.mjs --report reports/eval-conformance.md",
    "privacy:check": "node scripts/privacy-check.mjs",
    "examples": "node scripts/examples-check.mjs",
    "conform:desktop": "node scripts/desktop-conformance.mjs",
    "record:ax-trees": "node scripts/record-ax-tree.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@svatah/adapter-playwright": "workspace:*",
    "@svatah/bindings": "workspace:*",
    "@svatah/compiler": "workspace:*",
    "@svatah/migrate": "workspace:*",
    "@svatah/schema": "workspace:*",
    "@svatah/service": "workspace:*",
    "@svatah/spec": "workspace:*",
    "@svatah/steps": "workspace:*",
    "@svatah/surface": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "playwright": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
