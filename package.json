{
  "name": "yam",
  "version": "0.1.0",
  "private": true,
  "description": "Yam — a deterministic automation runtime with a standard agent surface",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/yam.git"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/yam/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm -r build",
    "browsers": "pnpm --filter @svatah/yam-adapter-playwright exec playwright install chromium firefox",
    "fixtures": "node scripts/compile-fixtures.mjs",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "seed:bindings": "node scripts/seed-fixture-bindings.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "sample-web": "pnpm --filter sample-web start",
    "yam": "node packages/cli/dist/bin.js",
    "conform:playwright": "node scripts/conform.mjs",
    "quick-start": "node scripts/quick-start.mjs",
    "eval:healing": "node scripts/eval-healing.mjs --report reports/eval-healing.md",
    "record:snapshots": "node scripts/record-snapshots.mjs",
    "grounding:cases": "node scripts/grounding-cases.mjs",
    "grounding:desktop-cases": "node scripts/desktop-grounding-cases.mjs",
    "self:record": "node scripts/self-record.mjs",
    "self:relocalize": "node scripts/self-relocalize.mjs",
    "self": "node scripts/seed-app-recents.mjs && node packages/cli/dist/bin.js eval self --update",
    "self:recents": "node scripts/seed-app-recents.mjs",
    "self:bite": "node scripts/self-parity-bite.mjs",
    "tree:agreement": "node scripts/tree-agreement.mjs",
    "eval:grounding": "node scripts/eval-grounding.mjs --report reports/eval-grounding.md",
    "app:client": "node scripts/generate-app-client.mjs",
    "bidi:independence": "node scripts/bidi-independence.mjs --report reports/adapter-bidi.md",
    "eval:compiler": "node scripts/eval-compiler.mjs --report reports/eval-compiler.md",
    "eval:conformance": "node scripts/adapter-conformance.mjs --report reports/eval-conformance.md",
    "privacy:check": "node scripts/privacy-check.mjs",
    "examples": "node scripts/examples-check.mjs",
    "conform:desktop": "node scripts/desktop-conformance.mjs",
    "record:desktop-trees": "node scripts/record-desktop-tree.mjs",
    "fixture:run": "node scripts/seed-fixture-run.mjs",
    "conform:runtime": "node scripts/runtime-conformance.mjs",
    "fixture:prototype-db": "node scripts/build-prototype-fixture.mjs",
    "finetune:export": "node packages/cli/dist/bin.js eval finetune export",
    "finetune:train": "node scripts/finetune-tier2.mjs",
    "finetune:eval": "node scripts/finetune-eval.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "quick-start:packed": "node scripts/quick-start-packed.mjs",
    "release:publish": "node scripts/publish.mjs",
    "app:smoke": "node scripts/app-smoke.mjs",
    "sheet": "pnpm --filter @svatah/yam-ui sheet",
    "sheet:audit": "node scripts/audit-sheet.mjs",
    "fixtures:screens": "node scripts/record-screen-fixtures.mjs",
    "sheet:shoot": "node scripts/shoot-sheet.mjs",
    "artboards": "node scripts/audit-artboards.mjs",
    "app:shoot": "node scripts/shoot-app.mjs",
    "app:shoot:update": "node scripts/shoot-app.mjs --update",
    "ui:capture": "node scripts/capture-tui.mjs",
    "self:http": "node scripts/self-http.mjs",
    "self:sdk": "node scripts/self-sdk.mjs",
    "quick-start:registry": "node scripts/quick-start-registry.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "catalog:",
    "@svatah/yam-adapter-playwright": "workspace:*",
    "@svatah/yam-bindings": "workspace:*",
    "@svatah/yam-compiler": "workspace:*",
    "@svatah/yam-migrate": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "@svatah/yam-screens": "workspace:*",
    "@svatah/yam-service": "workspace:*",
    "@svatah/yam-spec": "workspace:*",
    "@svatah/yam-steps": "workspace:*",
    "@svatah/yam-surface": "workspace:*",
    "@svatah/yam-ui": "workspace:*",
    "@svatah/yam-ui-tokens": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "jsdom": "^30.0.1",
    "playwright": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
