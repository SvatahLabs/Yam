{
  "name": "@svatah/yam-repo-checks",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-level checks that span package directories: import boundaries, licences, eval and documentation coverage",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/Yam.git",
    "directory": "tools/repo-checks"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/Yam/issues"
  },
  "type": "module",
  "scripts": {
    "build": "echo \"@svatah/yam-repo-checks has nothing to build\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@svatah/yam-schema": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@svatah/yam": "workspace:*",
    "@svatah/yam-compiler": "workspace:*",
    "@svatah/yam-migrate": "workspace:*",
    "@svatah/yam-screens": "workspace:*",
    "@svatah/yam-sdk": "workspace:*",
    "@svatah/yam-service": "workspace:*",
    "@svatah/yam-spec": "workspace:*",
    "@svatah/yam-surface-control": "workspace:*",
    "@svatah/yam-tui": "workspace:*",
    "@svatah/yam-ui-tokens": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "sample-web": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
