{
  "name": "@svatah/repo-checks",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-level checks that span package directories: import boundaries, licences, eval and documentation coverage",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "echo \"@svatah/repo-checks has nothing to build\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@svatah/schema": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@svatah/compiler": "workspace:*",
    "@svatah/screens": "workspace:*",
    "@svatah/migrate": "workspace:*",
    "@svatah/spec": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@svatah/sdk": "workspace:*",
    "sample-web": "workspace:*",
    "@svatah/ui-tokens": "workspace:*"
  }
}
