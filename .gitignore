# --- Node / pnpm workspace ---
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/
coverage/
.svatah/
test-results/
playwright-report/

# --- Gradle (runtimes/java) ---
.gradle/
build/
gradle-app.setting
.gradletasknamecache

# --- Java ---
*.class
*.war
*.ear

# Jars are ignored except the committed Gradle wrappers. A wrapper jar is how
# `./gradlew` bootstraps without a Gradle install, so a checkout without it
# cannot build either Java project (T6.4).
*.jar
!runtimes/java/gradle/wrapper/gradle-wrapper.jar

# --- Archives / logs / editors ---
*.zip
*.tar.gz
*.rar
*.log
*.iml
tmp/
target/
out/
out-test/
.idea/
.vscode/
.*.swp
.DS_Store
.COOKIE_*
.bash_profile

# --- Python (the generated client, T9.3) ---
# `clients/python` is a generated package that gets imported by
# `scripts/smoke-clients.mjs` on every run, and CPython writes a byte-code cache
# beside every module it imports. Two of them were committed in Phase 9 and
# changed on every smoke run (P9-F2); nothing reads them that cannot regenerate
# them in milliseconds.
__pycache__/
*.pyc

# --- Playwright ---
.last-run.json

# --- Electron / the ADE (T3.6) ---
# `out/` above already covers the installers; `.vite/` is Forge's build output.
.vite/

# The fine-tune's model artifacts (T6.5). The exported *pairs* and their
# manifest are committed — they are the training set and a reviewer reads them —
# but adapter weights and a fused GGUF are hundreds of megabytes and are
# reproducible from the pairs and the digest.
# The contents, not the directory: git cannot re-include a file inside an
# excluded directory, and the digest is the one thing in here that is published.
evals/compiler/finetune/tuned/*
# T7.5 asks for it by name — "publish the tuned digest". A few hundred bytes,
# and the only thing that says which weights and which schedule produced a
# published number.
!evals/compiler/finetune/tuned/digest.json

# The Phase 7 fine-tune virtual environment (T7.5). Multi-gigabyte, and a
# machine-local install of `mlx-lm`; `docs/finetune.md` says how to make one.
.venv-finetune/
.venv/

# Built into `@svatah/schema` from `evals/conformance/` at build time (T7.6).
# One source, one copy, and the copy is never committed.
packages/schema/conformance/

# `pnpm release:dry-run` output (T7.6): real tarballs, never published.
release/

# The CLI staged for the packaged ADE (T8.1). `scripts/stage-ade-cli.mjs`
# writes a `pnpm deploy` of `@svatah/cli` here and Forge copies it into
# `Resources/svatah`; it is a build product of `packages/cli/dist`.
apps/ade/.stage/

# The component sheet is generated by `pnpm --filter @svatah/ui build` (T9.2).
packages/ui/sheet/

# `docs/spec/design/build.mjs` expands the artboards for the design canvas.
# The artboards and `base.css` are the source; the expansion is a build product
# and belongs no more in the tree than `reports/` screenshots do (P10-F6).
docs/spec/design/*.dc.html
