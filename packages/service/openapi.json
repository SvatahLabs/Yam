{
  "openapi": "3.1.0",
  "info": {
    "title": "Svatah local service",
    "version": "0.1.0",
    "description": "The local integration point for the Svatah ADE and any other client (REQ-ADE-1, LLD §13.5). Bound to 127.0.0.1, behind a bearer token printed on stdout. Every handler calls the same function the CLI calls; no logic lives here."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "0"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token printed on stdout when the service starts."
      }
    }
  },
  "paths": {
    "/project": {
      "get": {
        "summary": "Config, flows, stories, compositions, run blocks and API names",
        "description": "Each story carries its `signature` when it declares one, so a client can prompt for inputs before starting a run (LLD §13.5).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "ProjectSummary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "root": {
                      "type": "string"
                    },
                    "flows": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "stories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "file": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "steps": {
                            "type": "integer"
                          },
                          "signature": {
                            "$ref": "https://svatah.dev/schema/signature.schema.json"
                          }
                        },
                        "required": [
                          "name",
                          "file",
                          "kind",
                          "steps"
                        ]
                      }
                    },
                    "compositions": {
                      "type": "object"
                    },
                    "runs": {
                      "type": "object"
                    },
                    "apis": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "customSteps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "diagnostics": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/flows/{file}": {
      "get": {
        "summary": "Read a flow file",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Write a flow file",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/compile": {
      "post": {
        "summary": "Compile and lint",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Plan reference, errors and warnings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/plan": {
      "get": {
        "summary": "The compiled plan, story by story",
        "description": "The object `svatah compile` writes to `.svatah/plan.json`. `POST /compile` answers with a reference; this is the plan the ADE's Plan screen renders.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://svatah.dev/schema/plan.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/run": {
      "post": {
        "summary": "Start a run; step events arrive on the stream",
        "description": "The inputs are validated against the signatures of the stories the run invokes directly, before anything starts (LLD §13.5).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "flows": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "host": {
                    "type": "string"
                  },
                  "inputs": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The run id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A story the run invokes declares an input nothing supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "missing-inputs"
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "story": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "story",
                          "name",
                          "type"
                        ]
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "missing",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "get": {
        "summary": "Every run's summary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "summary": "One run's summary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://svatah.dev/schema/results.summary.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/results": {
      "get": {
        "summary": "One run's step results",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "StepResult[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "https://svatah.dev/schema/results.step.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/audit": {
      "get": {
        "summary": "One run's audit log",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AuditLine[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/bindings": {
      "get": {
        "summary": "The bindings store",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "BindingFile[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/bindings/{id}": {
      "get": {
        "summary": "One binding",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "BindingFile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://svatah.dev/schema/bindings.file.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/data": {
      "put": {
        "summary": "Write data.yaml",
        "description": "A value that comes back still `«redacted»` means unchanged: the file keeps the secret it had, because the editor never saw it (REQ-NFR-6).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "values": {
                    "type": "object"
                  }
                },
                "required": [
                  "values"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The file written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "No values were sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Run data, with secrets redacted",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/screenshots/{name}": {
      "get": {
        "summary": "A screenshot a run wrote",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/request": {
      "post": {
        "summary": "Execute one API request ad hoc",
        "description": "Through the same function `svatah run` uses for an `api` step, so the ADE's API client is not a second HTTP client (LLD §13.5).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request": {
                    "$ref": "https://svatah.dev/schema/surface.api-request.schema.json"
                  },
                  "withSessionCookies": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "request"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ApiResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://svatah.dev/schema/surface.api-response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "The request could not be executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "501": {
            "description": "No HTTP adapter was wired in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/{name}": {
      "put": {
        "summary": "Save a named request under api/<name>.yaml",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://svatah.dev/schema/surface.api-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The file written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api": {
      "get": {
        "summary": "Named API requests",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "ApiRequest[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "The event stream (WebSocket)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols"
          }
        }
      }
    },
    "/events/sse": {
      "get": {
        "summary": "The event stream (server-sent events)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness, for the ADE's spawn handshake",
        "security": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
