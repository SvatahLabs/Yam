{
  "name": "@svatah/yam-service",
  "version": "0.1.0",
  "description": "Local HTTP and event-stream service (yam serve)",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/yam.git",
    "directory": "packages/service"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts && pnpm run generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/write-openapi.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "catalog:",
    "@svatah/yam-schema": "workspace:*",
    "fastify": "catalog:",
    "yaml": "catalog:",
    "@svatah/yam-surface-control": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
