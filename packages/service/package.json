{
  "name": "@svatah/service",
  "version": "0.1.0",
  "description": "Local HTTP and event-stream service (svatah serve)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && pnpm run generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/write-openapi.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "catalog:",
    "@svatah/schema": "workspace:*",
    "fastify": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
