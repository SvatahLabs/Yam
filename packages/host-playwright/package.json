{
  "name": "@svatah/yam-host-playwright",
  "version": "0.2.0",
  "description": "Playwright Test host for Yam flows: the yam fixture, generated specs and the results reporter",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/Yam.git",
    "directory": "packages/host-playwright"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/Yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "playwright": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@svatah/yam-adapter-playwright": "workspace:*",
    "@svatah/yam-bindings": "workspace:*",
    "@svatah/yam-playwright-test": "workspace:*",
    "@svatah/yam-runtime": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "@svatah/yam-surface": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:"
  }
}
