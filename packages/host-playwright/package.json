{
  "name": "@svatah/host-playwright",
  "version": "0.1.0",
  "description": "Playwright Test host for Svatah flows: the svatah fixture, generated specs and the results reporter",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "playwright": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@svatah/adapter-playwright": "workspace:*",
    "@svatah/bindings": "workspace:*",
    "@svatah/playwright-test": "workspace:*",
    "@svatah/runtime": "workspace:*",
    "@svatah/schema": "workspace:*",
    "@svatah/surface": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:"
  }
}
