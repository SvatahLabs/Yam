{
  "name": "@svatah/yam-mcp",
  "version": "0.1.0",
  "description": "The Yam MCP server: surface and operation tools over stdio or Streamable HTTP",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/Yam.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/Yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yam-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@svatah/yam": "workspace:*",
    "@svatah/yam-bindings-cli": "workspace:*",
    "@svatah/yam-compiler": "workspace:*",
    "@svatah/yam-contract": "workspace:*",
    "@svatah/yam-gateway": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "@svatah/yam-spec": "workspace:*",
    "@svatah/yam-surface": "workspace:*",
    "@svatah/yam-surface-control": "workspace:*",
    "@svatah/yam-trajectory": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
