{
  "name": "@svatah/yam-adapter-appium",
  "version": "0.2.0",
  "description": "Appium adapter: Android Chrome and native",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/Yam.git",
    "directory": "packages/adapter-appium"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/Yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@svatah/yam-page-script": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "@svatah/yam-surface": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "webdriverio": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "webdriverio": "catalog:"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": true
    }
  }
}
