{
  "name": "@svatah/playwright-test",
  "version": "0.1.0",
  "description": "Playwright Test host: bind() fixture, generated specs, dual results",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@svatah/adapter-playwright": "workspace:*",
    "@svatah/bindings": "workspace:*",
    "@svatah/healer": "workspace:*",
    "@svatah/schema": "workspace:*",
    "@svatah/surface": "workspace:*",
    "playwright": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  }
}
