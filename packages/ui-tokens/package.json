{
  "name": "@svatah/yam-ui-tokens",
  "version": "0.1.0",
  "description": "The Yam design tokens: two themes, one type ramp, one status set (REQ-ADE-12)",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/yam.git",
    "directory": "packages/ui-tokens"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "tokens.css",
    "fonts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && node scripts/write-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
