{
  "name": "@svatah/bindings-cli",
  "version": "0.1.0",
  "description": "The svatah-bindings command line: bindings, heal, surface conform and the healing eval for module (a)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@svatah/adapter-playwright": "workspace:*",
    "@svatah/bindings": "workspace:*",
    "@svatah/conformance": "workspace:*",
    "@svatah/healer": "workspace:*",
    "@svatah/schema": "workspace:*",
    "@svatah/surface": "workspace:*",
    "yaml": "catalog:"
  },
  "bin": {
    "svatah-bindings": "./dist/bin.js"
  }
}
