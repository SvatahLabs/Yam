{
  "name": "@svatah/spec",
  "version": "0.1.0",
  "description": "Flow reader, grammar, target dictionary, signatures",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions.yaml": "./actions.yaml"
  },
  "files": [
    "dist",
    "actions.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && pnpm run generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/write-actions-yaml.mjs"
  },
  "dependencies": {
    "@svatah/schema": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
