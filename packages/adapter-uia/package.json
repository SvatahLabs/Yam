{
  "name": "@svatah/adapter-uia",
  "version": "0.1.0",
  "description": "Windows UI Automation adapter: the Svatah agent surface over UIAutomationClient",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@svatah/surface": "workspace:*",
    "@svatah/schema": "workspace:*"
  },
  "devDependencies": {
    "@svatah/adapter-ax": "workspace:*",
    "@svatah/conformance": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svatah",
    "ui-automation",
    "windows",
    "automation",
    "agent-surface"
  ]
}
