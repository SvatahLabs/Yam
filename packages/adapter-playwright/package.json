{
  "name": "@svatah/yam-adapter-playwright",
  "version": "0.1.0",
  "description": "Default web adapter: AgentSurface on Playwright",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:browsers": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "dependencies": {
    "@svatah/yam-surface": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "playwright": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@svatah/yam-conformance": "workspace:*",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
