{
  "name": "@svatah/cli",
  "version": "0.1.0",
  "description": "The svatah CLI and MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@svatah/adapter-appium": "workspace:*",
    "@svatah/adapter-ax": "workspace:*",
    "@svatah/adapter-bidi": "workspace:*",
    "@svatah/adapter-http": "workspace:*",
    "@svatah/adapter-playwright": "workspace:*",
    "@svatah/adapter-uia": "workspace:*",
    "@svatah/bindings": "workspace:*",
    "@svatah/compiler": "workspace:*",
    "@svatah/conformance": "workspace:*",
    "@svatah/gateway": "workspace:*",
    "@svatah/healer": "workspace:*",
    "@svatah/host-playwright": "workspace:*",
    "@svatah/migrate": "workspace:*",
    "@svatah/playwright-test": "workspace:*",
    "@svatah/recorder": "workspace:*",
    "@svatah/runtime": "workspace:*",
    "@svatah/schema": "workspace:*",
    "@svatah/spec": "workspace:*",
    "@svatah/steps": "workspace:*",
    "@svatah/surface": "workspace:*",
    "@svatah/tool": "workspace:*",
    "@svatah/trajectory": "workspace:*",
    "@svatah/workflow": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@svatah/service": "workspace:*",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "svatah": "./dist/bin.js"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "@svatah/service": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@svatah/service": {
      "optional": true
    }
  }
}
