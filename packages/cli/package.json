{
  "name": "@svatah/yam",
  "version": "0.1.0",
  "description": "The yam CLI and MCP server",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/yam.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@svatah/yam-adapter-appium": "workspace:*",
    "@svatah/yam-adapter-atspi": "workspace:*",
    "@svatah/yam-adapter-ax": "workspace:*",
    "@svatah/yam-adapter-bidi": "workspace:*",
    "@svatah/yam-adapter-http": "workspace:*",
    "@svatah/yam-adapter-playwright": "workspace:*",
    "@svatah/yam-adapter-process": "workspace:*",
    "@svatah/yam-adapter-uia": "workspace:*",
    "@svatah/yam-bindings": "workspace:*",
    "@svatah/yam-bindings-cli": "workspace:*",
    "@svatah/yam-compiler": "workspace:*",
    "@svatah/yam-conformance": "workspace:*",
    "@svatah/yam-contract": "workspace:*",
    "@svatah/yam-gateway": "workspace:*",
    "@svatah/yam-healer": "workspace:*",
    "@svatah/yam-host-playwright": "workspace:*",
    "@svatah/yam-migrate": "workspace:*",
    "@svatah/yam-playwright-test": "workspace:*",
    "@svatah/yam-recorder": "workspace:*",
    "@svatah/yam-runtime": "workspace:*",
    "@svatah/yam-schema": "workspace:*",
    "@svatah/yam-sdk": "workspace:*",
    "@svatah/yam-service": "workspace:*",
    "@svatah/yam-spec": "workspace:*",
    "@svatah/yam-steps": "workspace:*",
    "@svatah/yam-surface": "workspace:*",
    "@svatah/yam-surface-control": "workspace:*",
    "@svatah/yam-tool": "workspace:*",
    "@svatah/yam-trajectory": "workspace:*",
    "@svatah/yam-tui": "workspace:*",
    "@svatah/yam-ui-tokens": "workspace:*",
    "@svatah/yam-workflow": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "catalog:",
    "sample-web": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yam": "./dist/bin.js"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "playwright": "catalog:",
    "webdriverio": "catalog:"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "webdriverio": {
      "optional": true
    }
  }
}
