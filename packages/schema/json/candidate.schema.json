{
  "$id": "https://svatah.dev/schema/1.0.0/candidate.schema.json",
  "$ref": "#/definitions/candidate",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "minLength": 1,
          "type": "string"
        },
        "by": {
          "enum": [
            "role",
            "label",
            "placeholder",
            "testid",
            "text",
            "altText",
            "title",
            "css",
            "xpath",
            "id",
            "name",
            "accessibilityId",
            "resourceId",
            "automationId",
            "controlPath",
            "webmcp",
            "coords"
          ],
          "type": "string"
        },
        "exact": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "nth": {
          "minimum": 0,
          "type": "integer"
        },
        "paramMap": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "score"
      ],
      "type": "object"
    }
  },
  "description": "One locator candidate (LLD §3.3). Svatah schemaVersion 1.0.0.",
  "title": "candidate",
  "x-svatah-schema-version": "1.0.0"
}
