{
  "$id": "https://yam.svatah.com/schema/1.0.0/target-ref.schema.json",
  "$ref": "#/definitions/target-ref",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "target-ref": {
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "minLength": 1,
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "page",
            "dialog",
            "frame",
            "desktop",
            "window"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "bound",
            "unbound",
            "ambiguous"
          ],
          "type": "string"
        }
      },
      "required": [
        "ref",
        "phrase",
        "status"
      ],
      "type": "object"
    }
  },
  "description": "The target of a step (LLD §3.2). Yam schemaVersion 1.0.0.",
  "title": "target-ref",
  "x-yam-schema-version": "1.0.0"
}
