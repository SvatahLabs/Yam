{
  "name": "@svatah/yam-schema",
  "version": "0.1.0",
  "description": "Zod definitions and generated JSON Schemas for the Yam artifact contracts",
  "license": "Apache-2.0",
  "homepage": "https://yam.svatah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SvatahLabs/yam.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/SvatahLabs/yam/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./action-forms": {
      "types": "./dist/action-forms.d.ts",
      "import": "./dist/action-forms.js"
    },
    "./json/*": "./json/*",
    "./conformance/*": "./conformance/*"
  },
  "files": [
    "dist",
    "json",
    "conformance",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate": "node scripts/write-json-schemas.mjs && node scripts/copy-conformance-fixture.mjs",
    "build": "tsup --config ./tsup.config.ts && pnpm run generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  }
}
