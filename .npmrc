# Node 22 LTS is the only supported runtime (REQ-NFR-7). engine-strict is left off
# so the repo still installs on newer Node for local experimentation; CI pins 22.
engine-strict=false
provenance=false

# Electron Forge refuses to package under pnpm unless a hoist pattern is set: a
# packaged app has to resolve its own dependencies from a plain `node_modules`,
# and pnpm's isolated layout is not one (T3.6).
#
# This is the narrowest thing that satisfies it. `node-linker=hoisted` — Forge's
# own suggestion — would turn isolation off for the whole workspace, and LLD §1
# depends on it: "with pnpm's strict isolation, the dependency-graph test is the
# guard that holds at run time". Hoisting only Electron's own packages leaves
# every `@svatah/*` boundary exactly where it was, and nothing in this workspace
# depends on Electron but the ADE.
public-hoist-pattern[]=*electron*
